#include <iostream>
#include <cmath>
#include <SDL2/SDL.h>

using namespace std;

// Screen dimension constants
const int SCREEN_WIDTH = 960;
const int SCREEN_HEIGHT = 480;

// The window's title
const char* gWindow_title = "SCP232: Orbit Simulation";

// Create the window
SDL_Window* gWindow = NULL;

// Creates a renderer to render our graphics
SDL_Renderer* gRenderer = NULL;

bool gINIT() {
    bool success = true;

    if (SDL_Init(SDL_INIT_EVERYTHING) != 0) {
        cout << "Error initializing SDL: " << SDL_GetError() << "\n";
        success = false;
    } else {
        // Create window
        gWindow = SDL_CreateWindow(gWindow_title, SDL_WINDOWPOS_UNDEFINED, SDL_WINDOWPOS_UNDEFINED, SCREEN_WIDTH, SCREEN_HEIGHT, SDL_WINDOW_SHOWN);

        if (gWindow == NULL) {
            cout << "Window could not be created! SDL_Error: " << SDL_GetError() << "\n";
            success = false;
        } else {
            // Creates a renderer to render our images
            gRenderer = SDL_CreateRenderer(gWindow, -1, SDL_RENDERER_ACCELERATED);

            if (gRenderer == NULL) {
                cout << "Renderer could not be created! SDL_Error: " << SDL_GetError() << "\n";
                success = false;
            }
        }
    }

    return success;
}

void gCLOSE() {
    // Destroy renderer
    SDL_DestroyRenderer(gRenderer);
    gRenderer = NULL;

    // Destroy window
    SDL_DestroyWindow(gWindow);
    gWindow = NULL;

    // Quit SDL
    SDL_Quit();
}

int main(int argc, char* args[]) {
    // Initialize SDL
    if (gINIT()) {
        bool quit = false;
        SDL_Event e;

        const int N = 100;
        const double pi = 4 * atan(1.0);

        int margin = 3;
        int box1_X1 = margin, box1_Y1 = margin, box1_X2 = SCREEN_WIDTH / 2 - 2 * margin, box1_Y2 = SCREEN_HEIGHT - 2 * margin;
        SDL_Rect frameRect1 = {box1_X1, box1_Y1, box1_X2, box1_Y2};
        int box2_X1 = SCREEN_WIDTH / 2, box2_Y1 = margin, box2_X2 = SCREEN_WIDTH / 2 - margin, box2_Y2 = SCREEN_HEIGHT - 2 * margin;
        SDL_Rect frameRect2 = {box2_X1, box2_Y1, box2_X2, box2_Y2};

        double X0 = box1_X1 + box1_X2 / 2, Y0 = box1_Y1 + box1_Y2 / 2;
        double dt = 0.02;

        // Size of particles
        double bigR = 10;
        double smallR = 1;

        // Orbit values
        double orbitRadius = 80;
        double theta = 0.0;
        double omega = 2.0;
        
        // Create background stars
        const int numStars = 500;
            int starX[numStars];
            int starY[numStars];
            for (int s = 0; s < numStars; s++) {
                starX[s] = rand() % SCREEN_WIDTH;
                starY[s] = rand() % SCREEN_HEIGHT;
            }

        
        // Main loop
        while (!quit) {
            // Handle events on queue
            while (SDL_PollEvent(&e) != 0) {
                // User requests quit
                if (e.type == SDL_QUIT) {
                    quit = true;
                }
            }

            // New coordinates of ball
            theta += omega * dt;

            double smallX = X0 + orbitRadius * cos(theta);
            double smallY = Y0 + orbitRadius * sin(theta);

            // Clear screen
            SDL_SetRenderDrawColor(gRenderer, 0, 0, 0, 255);
            SDL_RenderClear(gRenderer);

            // Draw frames
            SDL_SetRenderDrawColor(gRenderer, 255, 255, 255, 255);
            SDL_RenderDrawRect(gRenderer, &frameRect1);
            SDL_RenderDrawRect(gRenderer, &frameRect2);
            
            // Draw stars
            SDL_SetRenderDrawColor(gRenderer, 100, 100, 100, 255);
                    for (int s = 0; s < numStars; s++) {
                        SDL_RenderDrawPoint(gRenderer, starX[s], starY[s]);
                    }

            // Orbit path
            SDL_SetRenderDrawColor(gRenderer, 0x00, 0x00, 0x00, 0x00);
            for (int i = 0; i < N; i++) {
                SDL_RenderDrawPoint(
                    gRenderer,
                    X0 + orbitRadius * cos(2 * pi * i / N),
                    Y0 + orbitRadius * sin(2 * pi * i / N)
                );
            }

            // Draw planet
            SDL_SetRenderDrawColor(gRenderer, 255, 235, 100, 255);

            for (int r = 0; r <= bigR; r++) {
                for (int i = 0; i < N; i++) {
                    SDL_RenderDrawPoint(
                        gRenderer,
                        X0 + r * cos(2 * pi * i / N),
                        Y0 + r * sin(2 * pi * i / N)
                    );
                }
            }
            
            // Draw particle
            SDL_SetRenderDrawColor(gRenderer, 255, 255, 200, 255);
            for (int r = 0; r <= smallR; r++) {
                for (int i = 0; i < N; i++) {
                    SDL_RenderDrawPoint(
                        gRenderer,
                        smallX + r * cos(2 * pi * i / N),
                        smallY + r * sin(2 * pi * i / N)
                    );
                }
            }

            // Update the screen
            SDL_RenderPresent(gRenderer);

            // Delay frame rate = 120 fps
            SDL_Delay(1000 / 120);
        }
    }

    gCLOSE();
    return 0;
}